# ── storage ────────────────────────────────────────────────────────────────
GCA_DSN=dbname=governed_calendar

# ── which backends to talk to ──────────────────────────────────────────────
# sandbox = the persistent demo tenant. Flip to graph/clickup for production.
GCA_CALENDAR_PROVIDER=sandbox        # sandbox | graph
GCA_TASKS_PROVIDER=sandbox           # sandbox | clickup

GCA_TIMEZONE=America/New_York
GCA_PRINCIPAL=michael@example.com
GCA_ALERT_WEBHOOK=                   # optional: POST target for alerts

# ── Microsoft Graph (one app registration PER TENANT) ──────────────────────
# The org tenant and the principal's personal M365 are separate tenants and
# need separate registrations and separate admin consent. Restrict each app to
# the single governed mailbox with an Exchange ApplicationAccessPolicy.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_USER_ID=

# ── ClickUp (scoped to one list) ───────────────────────────────────────────
CLICKUP_TOKEN=
CLICKUP_LIST_ID=
